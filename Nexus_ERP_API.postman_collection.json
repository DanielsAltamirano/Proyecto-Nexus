	"item": [
		{
			"name": "01. Auth",
			"item": [
				{
					"name": "Iniciar Sesión (JWT)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@nexuserp.com\",\n    \"password\": \"123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Responsable: Daniels J. Altamirano. Autentica un usuario y genera token JWT."
					}
				}
			]
		},
