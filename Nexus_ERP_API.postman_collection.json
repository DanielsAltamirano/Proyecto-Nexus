							"path": ["api", "v1", "ventas"],
							"query": [
								{ "key": "fecha_inicio", "value": "2026-01-01" },
								{ "key": "fecha_fin", "value": "2026-12-31" }
							]
						},
						"description": "Responsable: Daniels J. Altamirano. Obtiene el historial paginado de ventas."
					}
				}
