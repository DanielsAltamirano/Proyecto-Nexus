# ==============================================================================
# Dockerfile.nginx - Contenedor Seguro Nginx (Usuario No-Root: appuser, Puerto 8080)
# Proyecto: Nexus ERP (Alta Disponibilidad en Kubernetes)
# ==============================================================================

# Etapa 1: Compilar assets estáticos de Vite (CSS/JS)
FROM node:20-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY public ./public
COPY vite.config.js postcss.config.js tailwind.config.js ./
RUN npm run build

# Etapa 2: Servidor Nginx endurecido sin privilegios root
FROM nginx:1.27-alpine

# 1. Crear grupo y usuario no-root (appuser - UID/GID 10001)
RUN addgroup -g 10001 -S appgroup \
    && adduser -u 10001 -S appuser -G appgroup

# 2. Copiar configuración de Nginx preparada para puerto 8080 y /tmp
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/templates/default.conf.template

# Variable por defecto para el servicio de PHP-FPM en Kubernetes/Docker
ENV PHP_FPM_HOST=127.0.0.1

# 3. Copiar únicamente los archivos públicos compilados
WORKDIR /var/www/html
COPY --from=assets /app/public /var/www/html/public

# 4. Configurar permisos de solo lectura en archivos estáticos y permisos en /etc/nginx/conf.d y /tmp
RUN chown -R appuser:appgroup /var/www/html/public /etc/nginx/conf.d /var/cache/nginx /var/log/nginx \
    && find /var/www/html/public -type d -exec chmod 550 {} + \
    && find /var/www/html/public -type f -exec chmod 440 {} + \
    && chmod 770 /etc/nginx/conf.d

# 5. Ejecutar como usuario no-root y exponer puerto no privilegiado 8080
USER appuser

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]

